---
// Botón con forma de enlace. Con `external` se abre en otra pestaña y lo avisa a lectores de pantalla.
import { useTranslations } from "../i18n/ui.js";

const { href, external = false } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const target = external ? { target: "_blank", rel: "noopener" } : {};
---

<a class="button" href={href} {...target}>
    <slot />
    {external && <span aria-hidden="true">↗</span>}
    {external && <span class="sr-only">{t("link.newTab")}</span>}
</a>

<style>
    .button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.875rem;
        border: 1px solid var(--carbon);
        font-family: var(--mono);
        font-size: var(--t-body);
        color: var(--blanco);
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s, border-color 0.2s;
    }

    .button:hover {
        border-color: var(--blanco);
        background: var(--blanco);
        color: var(--grafito);
    }

    .button:focus-visible {
        outline: 2px solid var(--blanco);
        outline-offset: 2px;
    }
</style>
