---
import Glass from "./Glass.astro";
import LangSwitch from "./LangSwitch.astro";
import { useTranslations } from "../i18n/ui.js";
import { sections, notesSlug } from "../i18n/routes.js";

const lang = Astro.currentLocale;
const t = useTranslations(lang);

// Un enlace por sección, con la ruta y el texto del idioma actual, y al final las notas,
// que no tienen color propio (van sin el cuadro).
const links = [
    ...sections.map((section) => ({
        label: t(`section.${section.id}`),
        href: `/${lang}/${section.slug[lang]}`,
        color: `var(${section.token})`,
    })),
    {
        label: t("nav.notes"),
        href: `/${lang}/${notesSlug[lang]}`,
        color: "transparent",
        plain: true,
    },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="bar">
    <Glass>
        <div class="row">
            <a class="logo" href={`/${lang}/`} aria-label={t("nav.home")}>
                <img src="/isotipo-blanco.svg" alt="" width="27" height="30" />
            </a>
            <div class="desktop">
                <nav class="links" aria-label={t("nav.label")}>
                    {links.map((link) => (
                        <a
                            href={link.href}
                            class:list={[{ plain: link.plain }]}
                            style={`--c: ${link.color}`}
                            aria-current={
                                current === link.href ? "page" : undefined
                            }
                        >
                            {link.label}
                        </a>
                    ))}
                </nav>
                <span class="sep" aria-hidden="true"></span>
                <LangSwitch />
            </div>
            <button class="menu-button" type="button" popovertarget="menu">
                {t("menu.button")}
            </button>
        </div>
    </Glass>

    <!--Mobile Menu-->
    <div id="menu" class="menu" popover>
        <Glass>
            <nav class="links" aria-label={t("nav.label")}>
                {links.map((link) => (
                    <a
                        href={link.href}
                        class:list={[{ plain: link.plain }]}
                        style={`--c: ${link.color}`}
                        aria-current={
                            current === link.href ? "page" : undefined
                        }
                    >
                        {link.label}
                    </a>
                ))}
            </nav>
            <div class="menu-lang">
                <LangSwitch />
            </div>
        </Glass>
    </div>
</header>

<script>
    // El panel abierto queda por encima de todo
    // se cierra antes de navegar para que la mascara lo tape.
    document.addEventListener("astro:before-preparation", () => {
        const menu = document.getElementById("menu");
        if (menu?.matches(":popover-open")) menu.hidePopover();
    });
</script>

<style>
    .bar {
        position: fixed;
        top: 1.5rem;
        left: 2rem;
        right: 2rem;
        z-index: var(--z-bar);
    }

    .row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 3.75rem;
        padding: 0 1.375rem;
    }

    .logo {
        display: flex;
    }

    .desktop {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .sep {
        width: 1px;
        height: 1.5rem;
        background: var(--line);
    }

    .links {
        display: flex;
        gap: 0.25rem;
    }

    .links a {
        padding: 0.5rem 0.875rem;
        font-family: var(--mono);
        font-size: var(--t-body);
        color: var(--niebla);
        text-decoration: none;
        white-space: nowrap;
    }

    .links a::before {
        content: "";
        display: inline-block;
        width: 9px;
        height: 9px;
        margin-right: 9px;
        background: var(--c);
    }

    .links a.plain::before {
        display: none;
    }

    .links a:hover,
    .links a[aria-current="page"] {
        color: var(--blanco);
    }

    .menu-button {
        display: none;
        padding: 0.5rem;
        border: 0;
        background: none;
        font-family: var(--mono);
        font-size: var(--t-body);
        color: var(--niebla);
        cursor: pointer;
    }

    .menu-button:hover {
        color: var(--blanco);
    }

    a:focus-visible,
    .menu-button:focus-visible {
        outline: 2px solid var(--blanco);
        outline-offset: 2px;
    }

    /* El navegador da estilos propios a los popover (borde, fondo, centrado):
       aquí se anulan y el panel se coloca debajo de la barra. */
    .menu {
        inset: 5.75rem 1rem auto;
        width: auto;
        height: auto;
        margin: 0;
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        overflow: visible;
    }

    .menu .links {
        flex-direction: column;
        padding: 0.5rem;
    }

    .menu .links a {
        padding: 0.75rem;
    }

    .menu-lang {
        margin: 0 0.5rem;
        padding: 0.5rem 0 0.75rem;
        border-top: 1px solid var(--line);
    }

    @media (max-width: 40rem) {
        .bar {
            left: 1rem;
            right: 1rem;
        }

        .row {
            padding: 0 0.75rem;
        }

        .desktop {
            display: none;
        }

        .menu-button {
            display: block;
        }
    }
</style>
