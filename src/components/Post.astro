---
// Plantilla de post (nota o breakdown): índice fijo a la izquierda y el texto a la derecha,
// con fecha, sección, minutos de lectura y el aviso si se muestra el otro idioma.
import { render } from "astro:content";
import Button from "./Button.astro";
import { useTranslations } from "../i18n/ui.js";
import { sections } from "../i18n/routes.js";
import { formatDate } from "../lib/notes.js";

const { note, back } = Astro.props;
const lang = Astro.currentLocale;
const t = useTranslations(lang);
const { data } = note.entry;
const section = sections.find((s) => s.id === data.section);
const { Content, headings } = await render(note.entry);
const toc = headings.filter((heading) => heading.depth === 2);
const notice = note.fallback
    ? t("note.untranslated").replace("{lang}", t(`lang.name.${note.lang}`))
    : null;
---

<article class="post" style={`--c: var(${section.token})`}>
    <aside class="toc">
        <nav aria-labelledby="toc-title">
            <p id="toc-title" class="toc-title">{t("note.toc")}</p>
            <ol>
                {
                    toc.map((heading) => (
                        <li>
                            <a href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                    ))
                }
            </ol>
        </nav>
    </aside>

    <div class="main">
        <header class="head">
            {notice && <p class="notice">{notice}</p>}
            <p class="kicker">
                <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date, lang)}</time>
                {` · ${t(`section.${section.id}`)} · ${note.minutes} ${t("note.minutes")}`}
            </p>
            <div lang={note.fallback ? note.lang : undefined}>
                <h1>{data.title}</h1>
                <p class="lead">{data.description}</p>
            </div>
        </header>

        <div class="prose" lang={note.fallback ? note.lang : undefined}>
            <Content />
        </div>

        <footer class="foot">
            {
                (data.download || data.repo) && (
                    <div class="files">
                        {data.download && <Button href={data.download.href}>{data.download.label} ↓</Button>}
                        {data.repo && (
                            <Button href={data.repo} external>
                                {t("note.repo")}
                            </Button>
                        )}
                    </div>
                )
            }
            {back && <a class="back" href={back.href}>{back.label}</a>}
        </footer>
    </div>
</article>

<style>
    .post {
        display: grid;
        grid-template-columns: minmax(10rem, 14rem) minmax(0, 46rem);
        gap: 3rem 5rem;
        justify-content: center;
    }

    /* Índice fijo: acompaña la lectura mientras haya post. */
    .toc {
        position: sticky;
        top: 7rem;
        align-self: start;
    }

    .toc-title {
        margin: 0 0 0.75rem;
        font-family: var(--mono);
        font-size: var(--t-label);
        color: var(--gris);
    }

    .toc ol {
        display: grid;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: toc;
    }

    .toc a {
        display: flex;
        gap: 0.625rem;
        color: var(--niebla);
        text-decoration: none;
        line-height: 1.35;
    }

    .toc a::before {
        counter-increment: toc;
        content: counter(toc, decimal-leading-zero);
        font-family: var(--mono);
        font-size: var(--t-label);
        line-height: 1.8;
        color: var(--c);
    }

    .toc a:hover {
        color: var(--blanco);
    }

    .notice {
        margin: 0 0 1.5rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--c);
        font-family: var(--mono);
        font-size: var(--t-label);
        color: var(--blanco);
    }

    .kicker {
        margin: 0;
        font-family: var(--mono);
        font-size: var(--t-label);
        color: var(--gris);
    }

    h1 {
        margin: 1rem 0;
        font-size: var(--t-h2);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--blanco);
        text-wrap: balance;
    }

    .lead {
        margin: 0;
        font-size: var(--t-lead);
        line-height: 1.4;
        color: var(--niebla);
        text-wrap: pretty;
    }

    /* El contenido viene del MDX: sus etiquetas no llevan el atributo de este componente,
       por eso los estilos van con :global() dentro de .prose. */
    .prose {
        margin-top: 1rem;
        color: var(--niebla);
    }

    .prose :global(h2) {
        margin: 3.5rem 0 1rem;
        font-size: var(--t-h3);
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--blanco);
        scroll-margin-top: 7rem;
    }

    .prose :global(h3) {
        margin: 2rem 0 0.75rem;
        font-size: var(--t-lead);
        font-weight: 500;
        color: var(--blanco);
    }

    .prose :global(p),
    .prose :global(ul),
    .prose :global(ol) {
        max-width: 68ch;
    }

    .prose :global(li + li) {
        margin-top: 0.375rem;
    }

    .prose :global(strong) {
        color: var(--blanco);
    }

    .prose :global(a) {
        color: var(--blanco);
        text-underline-offset: 0.2em;
    }

    .prose :global(code) {
        font-family: var(--mono);
        font-size: 0.88em;
    }

    .prose :global(:not(pre) > code) {
        padding: 0.05em 0.2em;
        background: var(--panel);
        color: var(--blanco);
    }

    .prose :global(pre) {
        margin: 1.5rem 0;
        padding: 1.125rem 1.25rem;
        border: 1px solid var(--line);
        background: var(--panel) !important;
        font-size: var(--t-label);
        line-height: 1.7;
        overflow-x: auto;
    }

    .prose :global(pre:focus-visible) {
        outline: 2px solid var(--blanco);
        outline-offset: 2px;
    }

    .prose :global(table) {
        width: 100%;
        margin: 1.5rem 0;
        border-collapse: collapse;
    }

    .prose :global(th),
    .prose :global(td) {
        padding: 0.5rem 0.75rem 0.5rem 0;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
    }

    .prose :global(th) {
        font-family: var(--mono);
        font-size: var(--t-label);
        font-weight: 400;
        color: var(--gris);
    }

    .prose :global(.viewer) {
        margin: 2rem 0;
    }

    .foot {
        display: grid;
        gap: 1.5rem;
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--line);
    }

    .files {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .back {
        font-family: var(--mono);
        color: var(--gris);
        text-decoration: none;
    }

    .back:hover {
        color: var(--blanco);
    }

    .toc a:focus-visible,
    .back:focus-visible {
        outline: 2px solid var(--blanco);
        outline-offset: 2px;
    }

    @media (max-width: 56rem) {
        .post {
            grid-template-columns: minmax(0, 1fr);
        }

        .toc {
            position: static;
            grid-row: 2;
            padding: 1.25rem 0;
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
        }

        .main {
            display: contents;
        }

        .head {
            grid-row: 1;
        }

        .prose,
        .foot {
            grid-row: auto;
        }
    }
</style>
