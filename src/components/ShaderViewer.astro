---
// Visor de shader reutilizable: un canvas con el fragment shader `src/shaders/viewers/<shader>.frag`
// y un control por parámetro (los de src/scripts/viewer-params.js).
import Glass from "./Glass.astro";
import { useTranslations } from "../i18n/ui.js";
import { viewers } from "../scripts/viewer-params.js";

const { shader, label } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const params = viewers[shader]?.params ?? [];
const uid = `viewer-${shader}`;
// Qué parte del deslizador va en color: del mínimo al valor, en porcentaje.
const fill = (param) => `${((param.value - param.min) / (param.max - param.min)) * 100}%`;
---

<figure class="viewer" data-shader={shader}>
    <div class="stage">
        <canvas role="img" aria-label={label}></canvas>
        <p class="fallback">{t("viewer.noGl")}</p>
    </div>
    <Glass>
        <div class="controls">
            {
                params.map((param) => (
                    <label class="param">
                        <span>{t(`viewer.${param.id}`)}</span>
                        <input
                            id={`${uid}-${param.id}`}
                            type="range"
                            min={param.min}
                            max={param.max}
                            step={param.step}
                            value={param.value}
                            data-param={param.id}
                            style={`--fill: ${fill(param)}`}
                        />
                        <output for={`${uid}-${param.id}`}>{param.value}</output>
                    </label>
                ))
            }
            <span class="hint">{t("viewer.hint")}</span>
        </div>
    </Glass>
</figure>

<script>
    import "../scripts/viewer.js";
</script>

<style>
    .viewer {
        margin: 0;
    }

    .stage {
        position: relative;
        aspect-ratio: 16 / 9;
        border: 1px solid var(--line);
        background: #000;
    }

    canvas {
        display: block;
        width: 100%;
        height: 100%;
        cursor: crosshair;
    }

    .fallback {
        display: none;
        position: absolute;
        inset: 0;
        place-items: center;
        margin: 0;
        padding: 1rem;
        font-family: var(--mono);
        color: var(--gris);
        text-align: center;
    }

    .viewer.no-gl .fallback {
        display: grid;
    }

    .viewer :global(.glass) {
        --ch: 14px;
        margin-top: 1rem;
    }

    /* Los controles van en columnas iguales: dos en escritorio, una en móvil. */
    .controls {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
        gap: 0.25rem 2.5rem;
        padding: 0.875rem 1.375rem;
        font-family: var(--mono);
        color: var(--niebla);
    }

    /* Etiqueta, deslizador y valor con anchos fijos: así todos los deslizadores
       empiezan y terminan en el mismo lugar, sin importar el largo de la etiqueta. */
    .param {
        display: grid;
        grid-template-columns: 6rem minmax(0, 1fr) 2.75rem;
        align-items: center;
        gap: 0.75rem;
    }

    /* Deslizador propio en lugar del nativo, que cada navegador dibuja distinto.
       Línea fina, parte recorrida en el color de la sección y un cuadro sin esquinas redondeadas. */
    input {
        --track: linear-gradient(
            to right,
            var(--c, var(--shading)) var(--fill),
            rgb(255 255 255 / 0.3) var(--fill)
        );
        appearance: none;
        -webkit-appearance: none;
        width: 100%;
        height: 2rem;
        margin: 0;
        background: none;
        cursor: pointer;
    }

    input::-webkit-slider-runnable-track {
        height: 2px;
        background: var(--track);
    }

    input::-moz-range-track {
        height: 2px;
        background: var(--track);
    }

    input::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 14px;
        height: 14px;
        margin-top: -6px;
        border: 0;
        border-radius: 0;
        background: var(--blanco);
    }

    input::-moz-range-thumb {
        width: 14px;
        height: 14px;
        border: 0;
        border-radius: 0;
        background: var(--blanco);
    }

    input:focus-visible {
        outline: 2px solid var(--blanco);
        outline-offset: 2px;
    }

    output {
        color: var(--blanco);
        text-align: right;
    }

    .hint {
        grid-column: 1 / -1;
        justify-self: end;
        color: var(--gris);
    }

    /* En pantallas táctiles la luz se mueve tocando el visor: la pista del cursor sobra. */
    @media not (hover: hover) {
        .hint {
            display: none;
        }
    }
</style>
