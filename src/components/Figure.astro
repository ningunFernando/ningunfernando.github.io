---
// Figura de un post: una imagen (optimizada por Astro) o un video corto en bucle, en lugar de un GIF.
// Con movimiento reducido, el video no arranca solo y muestra sus controles.
import { Image } from "astro:assets";

const { src, video, alt = "", caption } = Astro.props;
---

<figure class="figure">
    {
        video ? (
            <video src={video} autoplay muted loop playsinline aria-label={alt} data-autoplay />
        ) : (
            src && (
                <Image src={src} alt={alt} widths={[640, 1280]} sizes="(max-width: 48rem) 100vw, 46rem" />
            )
        )
    }
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
    document.addEventListener("astro:page-load", () => {
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        for (const video of document.querySelectorAll("video[data-autoplay]")) {
            video.pause();
            video.controls = true;
        }
    });
</script>

<style>
    .figure {
        margin: 2rem 0;
    }

    .figure :global(img),
    video {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--line);
    }

    figcaption {
        margin-top: 0.75rem;
        font-family: var(--mono);
        font-size: var(--t-label);
        color: var(--gris);
    }
</style>
