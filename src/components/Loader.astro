---
import { useTranslations } from "../i18n/ui";
const t = useTranslations(Astro.currentLocale);
---

<div id="loader" class="loader" transition:persist>
    <div class="bg"></div>
    <canvas class="canvas"></canvas>
    <button class="skip" type="button" aria-keyshortcuts="Escape">
        {t("loader.skip")}
    </button>
</div>

<noscript>
    <style is:inline>
        #loader {
            display: none;
        }
    </style>
</noscript>

<script>
    import "../scripts/loader.js";
</script>

<style>
    .loader {
        position: fixed;
        inset: 0;
        z-index: var(--z-loader);
    }

    .bg {
        position: absolute;
        inset: 0;
        background: var(--grafito);
    }

    .canvas {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
    }

    .skip {
        position: absolute;
        right: 2rem;
        bottom: 2rem;
        padding: 0.5rem;
        border: 0;
        background: none;
        font-family: var(--mono);
        font-size: var(--t-body);
        color: var(--niebla);
        cursor: pointer;
    }

    .skip:hover {
        color: var(--blanco);
    }

    .skip:focus-visible {
        outline: 2px solid var(--blanco);
        outline-offset: 2px;
    }
</style>
