---
import Base from "../../layouts/Base.astro";
import { useTranslations } from "../../i18n/ui.js";
import { getSectionPaths } from "../../i18n/routes.js";

// Seis páginas: shading, tools y otros/other en cada idioma.
export function getStaticPaths() {
    return getSectionPaths();
}

const { id } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const name = t(`section.${id}`);
---

<Base title={`${name} - ningunfernando`}>
    <h1>{name}</h1>
</Base>
