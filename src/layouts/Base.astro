---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Bar from "../components/Bar.astro";
import "../styles/global.css";
import Loader from "../components/Loader.astro";

// full: la página ocupa todo el ancho y alto, sin el margen de main (la intro del inicio).
const { title, full = false } = Astro.props;
const lang = Astro.currentLocale;
// El feed de notas solo existe cuando hay dominio (`site` en astro.config.mjs).
const rssHref = Astro.site ? new URL(`/${lang}/rss.xml`, Astro.site).href : null;
---

<!doctype html>
<html lang={Astro.currentLocale} transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="icon" href="/favicon.ico" sizes="48x48" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#000000" />
        {rssHref && <link rel="alternate" type="application/rss+xml" title="ningunfernando" href={rssHref} />}
        <Font cssVariable="--font-space-grotesk" preload />
        <Font cssVariable="--font-jetbrains-mono" />
        <ClientRouter />
    </head>
    <body>
        <canvas id="mask" transition:persist></canvas>
        <Loader />
        <Bar />
        <main class:list={[{ full }]}>
            <slot />
        </main>
        <script>
            import "../scripts/mask.js";
        </script>
    </body>
</html>

<style>
    #mask {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: var(--z-mask);
        pointer-events: none;
    }
    main {
        padding: 7rem 2rem 4rem;
    }

    main.full {
        padding: 0;
    }
</style>
