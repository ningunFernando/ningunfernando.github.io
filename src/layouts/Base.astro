---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "../styles/global.css";
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <Font cssVariable="--font-space-grotesk" preload />
        <Font cssVariable="--font-jetbrains-mono" />
        <ClientRouter />
    </head>
    <body>
        <canvas id="mask" transition:persist></canvas>
        <slot />
        <script>
            import "../scripts/mask.js";
        </script>
    </body>
</html>

<style>
    #mask {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: var(--z-mask);
        pointer-events: none;
    }
</style>
