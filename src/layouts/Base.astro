---
import { ClientRouter } from "astro:transitions";
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <ClientRouter />
    </head>
    <body>
        <canvas id="mask" transition:persist></canvas>
        <slot />
        <script>
            import "../scripts/mask.js";
        </script>
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        background: #0a0a0a;
        color: white;
        font-family: "Space Grotesk", system-ui, sans-serif;
    }
    #mask {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 100;
        pointer-events: none;
    }
</style>
